generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
  TRIALING
}

enum LogLevel {
  INFO
  WARN
  ERROR
  FATAL
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  geminiApiKey String?
  openaiApiKey String?
  claudeApiKey String?

  sessions           Session[]
  accounts           Account[]
  workflows          Workflow[]
  dataLibraryFiles   DataLibraryFile[]
  masterSheets       MasterSheet[]
  subscriptions      Subscription[]
  auditLogs          AuditLog[]
  systemUsageMetrics SystemUsageMetric[]
  organizationMemberships OrganizationMember[]
  joinRequests            OrganizationJoinRequest[]
  receivedStars           UserStar[]           @relation("UserReceivedStars")
  givenStars              UserStar[]           @relation("UserGivenStars")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Workflow {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String
  name        String
  slug        String? @unique
  description String?

  definition Json

  isPublic   Boolean  @default(false)
  isTemplate Boolean  @default(false)
  tags       String[] @default([])

  organizationId String?  @db.Uuid
  groupId        String?  @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileFolders      FileFolder[]
  dataLibraryFiles DataLibraryFile[]
  deskBlocks       DeskBlock[]       @relation("ProjectBlocks")
  blockEditor      DeskBlock?        @relation("BlockEditor")

  @@index([userId])
  @@index([isPublic])
  @@index([organizationId])
  @@index([groupId])
  @@index([isTemplate])
  @@map("workflow")
}

model FileFolder {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String
  workflowId  String   @db.Uuid
  name        String
  description String?
  color       String?  @default("indigo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workflow Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  files    DataLibraryFile[]

  @@unique([workflowId, name])
  @@index([workflowId])
  @@index([userId])
  @@map("file_folder")
}

model DataLibraryFile {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String
  workflowId  String? @db.Uuid
  folderId    String? @db.Uuid
  name        String
  description String?
  fileType    String
  data        Json?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow Workflow?   @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  folder   FileFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workflowId])
  @@index([folderId])
  @@map("data_library_file")
}

model MasterSheet {
  id       String @id @default(uuid()) @db.Uuid
  userId   String
  name     String
  data     Json? // { columns: string[], data: any[][] }
  metadata Json? // { rowCount, colCount, blockCodes, lastMergedAt }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  history MasterSheetHistory[]
  shares  DeskShare[]

  @@index([userId])
  @@map("master_sheet")
}

model MasterSheetHistory {
  id            String  @id @default(uuid()) @db.Uuid
  masterSheetId String  @db.Uuid
  userId        String
  userName      String
  action        String // "merge" | "reject" | "update"
  dataBefore    Json? // snapshot before change
  dataAfter     Json? // snapshot after change
  changeSummary String? // "Added 3 columns from CO24553:Th"

  createdAt DateTime @default(now())

  masterSheet MasterSheet @relation(fields: [masterSheetId], references: [id], onDelete: Cascade)

  @@index([masterSheetId])
  @@map("master_sheet_history")
}

model DeskShare {
  id                String   @id @default(uuid()) @db.Uuid
  masterSheetId     String   @db.Uuid
  invitedEmail      String
  invitedUserId     String?
  permission        String   @default("editor") // "editor" | "viewer"
  reservedColumns   String[] @default([]) // e.g. ["Math_Score", "Physics_Score"]
  projectWorkflowId String?  @db.Uuid // link to project for desk-level sharing
  status            String   @default("pending") // "pending" | "accepted" | "rejected"

  createdAt DateTime @default(now())

  masterSheet MasterSheet @relation(fields: [masterSheetId], references: [id], onDelete: Cascade)

  @@unique([masterSheetId, invitedEmail])
  @@index([invitedEmail])
  @@index([projectWorkflowId])
  @@map("desk_share")
}

model DeskBlock {
  id                String   @id @default(uuid()) @db.Uuid
  projectWorkflowId String   @db.Uuid
  editorWorkflowId  String   @unique @db.Uuid
  name              String   @default("Block")
  blockOrder        Int      @default(0)
  parentId          String?  @db.Uuid // Tree parent block ID (null for root blocks)
  treeDepth         Int      @default(0) // 0 for root (b1), 1 for children (b2), etc.
  reservedColumns   String[] @default([]) // Columns this block is allowed to write to in MasterSheet

  coOwnerEmail        String?
  isPasswordProtected Boolean  @default(false)
  passwordHash        String?
  settings            Json?    @default("{}")

  textInputs     Json? // [{id, placeholder, value}]
  sheets         Json? // [{id, name, data: {columns, data}}]
  outputPreview  Json? // {columns, data}
  checkboxFields Json? // [{id, label, checked}]
  pushedFiles    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectWorkflow Workflow @relation("ProjectBlocks", fields: [projectWorkflowId], references: [id], onDelete: Cascade)
  editorWorkflow  Workflow @relation("BlockEditor", fields: [editorWorkflowId], references: [id], onDelete: Cascade)

  parent   DeskBlock?  @relation("TreeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children DeskBlock[] @relation("TreeHierarchy")

  @@index([projectWorkflowId])
  @@index([parentId])
  @@index([blockOrder])
  @@map("desk_block")
}

model CodeMapping {
  id                String   @id @default(uuid()) @db.Uuid
  projectWorkflowId String   @db.Uuid
  codePath          String   // e.g. "CO24009/Lab", "CO24009/Th", "Sheet1/Name"
  columnKeyMap      Json     // { "Total_Present": 4, "Total_Classes": 5, "Percentage": 6 }
  mergeConfig       Json?    // { "Total_Present": { "op": "+", "sourceField": "attended" }, ... }
  filePath          String?  // workspace folder path to auto-save data file
  fileId            String?  @db.Uuid // reference to workspace file
  fileName          String?  // auto-save file name
  metadata          Json?    // extra metadata (detected headers, last merge timestamp, etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectWorkflowId, codePath])
  @@index([projectWorkflowId])
  @@map("code_mapping")
}

model DeskMessage {
  id                String   @id @default(uuid()) @db.Uuid
  projectWorkflowId String   @map("project_workflow_id") @db.Uuid
  userId            String   @map("user_id")
  userName          String   @map("user_name")
  userEmail         String   @map("user_email")
  userImage         String?  @map("user_image")
  text              String
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([projectWorkflowId, createdAt])
  @@map("desk_message")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String
  type      String // "desk_invite" | "data_commit" | "system"
  title     String
  message   String
  data      Json? // payload e.g. { projectWorkflowId, masterSheetId, shareId }
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@map("notification")
}

// ==========================================
// NEW MODELS FOR SUBSCRIBERS / PAYMENTS
// ==========================================

model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   // e.g., "Pro", "Enterprise"
  description String?
  price       Float
  currency    String   @default("USD")
  interval    String   @default("month") // "month" | "year"
  isActive    Boolean  @default(true)
  features    String[] @default([])

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plan")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String
  planId               String             @db.Uuid
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("subscription")
}

// ==========================================
// NEW MODEL FOR LOGS
// ==========================================

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  // Nullable if system-level event
  action    String   // e.g., "USER_BANNED", "WORKFLOW_EXECUTED", "API_KEY_UPDATED"
  entity    String   // e.g., "User", "Workflow", "System"
  entityId  String?
  level     LogLevel @default(INFO)
  details   Json?    // Context payload (request IP, parameters, stack trace)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([level])
  @@index([createdAt])
  @@map("audit_log")
}

// ==========================================
// NEW MODEL FOR ANALYTICAL USAGE TRACKING
// ==========================================

model SystemUsageMetric {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?
  metricName     String   // e.g., "api_call", "tokens_used", "workflow_run"
  count          Int      @default(1)
  metadata       Json?    // e.g., { provider: "openai", tokens: 450 }
  timestamp      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([metricName])
  @@index([timestamp])
  @@map("system_usage_metric")
}

// ==========================================
// NEW MODEL FOR GLOBAL APP SETTINGS
// ==========================================

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // e.g., "MAINTENANCE_MODE", "DEFAULT_MAX_WORKFLOWS"
  value       Json     // Stored value (boolean, string, object, number)
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_setting")
}

model Admin {
  id           String    @id
  name         String
  email        String    @unique
  password     String
  role         String    @default("ADMIN")
  image        String?
  metadata     Json?     @default("{}")
  geminiApiKey String?
  openaiApiKey String?
  claudeApiKey String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin")
}

// ==========================================
// ORGANIZATION & ORGANIZER MODELS
// ==========================================

model Organizer {
  id                   String                  @id @default(uuid()) @db.Uuid
  name                 String
  email                String                  @unique
  password             String?
  avatar               String?
  role                 String                  @default("ORGANIZER")
  phone                String?
  status               String                  @default("ACTIVE") // ACTIVE, SUSPENDED
  activeOrganizationId String?                 @db.Uuid
  metadata             Json?                   @default("{}") // Extensible for sidebar/enterprise features
  lastLoginAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  handledOrganizations OrganizerOrganization[]
  auditLogs            OrganizationAuditLog[]

  @@map("organizer")
}

model OrganizerOrganization {
  id             String       @id @default(uuid()) @db.Uuid
  organizerId    String       @db.Uuid
  organizationId String       @db.Uuid
  role           String       @default("owner") // "owner" | "admin" | "manager"
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  organizer      Organizer    @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizerId, organizationId])
  @@index([organizerId])
  @@index([organizationId])
  @@map("organizer_organization")
}

model Organization {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  logoUrl      String?
  tagline      String?
  description  String?
  website      String?
  contactEmail String?
  phone        String?
  location     String?
  ownerId      String   // Organizer ID who created/owns this org
  ownerEmail   String
  rules        Json?    // Array of compliance rules string[]
  settings     Json?    // { allowJoinRequests, autoApproveMembers, workingHours, defaultDeskTemplate }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  handlers      OrganizerOrganization[]
  members       OrganizationMember[]
  groups        OrganizationGroup[]
  assignments   OrganizationDeskAssignment[]
  joinRequests  OrganizationJoinRequest[]
  announcements OrganizationAnnouncement[]
  assets        OrganizationAsset[]
  messages      OrganizationMessage[]
  projects      OrganizationProject[]
  auditLogs     OrganizationAuditLog[]

  @@index([ownerId])
  @@index([slug])
  @@map("organization")
}

model OrganizationMember {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @db.Uuid
  userId         String?
  name           String
  email          String
  avatar         String?
  role           String                    @default("member") // "owner" | "admin" | "member"
  title          String?
  department     String?
  status         String                    @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  joinedAt       DateTime                  @default(now())

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  groupMemberships OrganizationGroupMember[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_member")
}

model OrganizationGroup {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @db.Uuid
  name           String                    // e.g. "Robotics Core", "Telemetry Data Desk"
  slug           String
  description    String?
  deskName       String?                   // Associated Desk pipeline
  leaderId       String?                   @db.Uuid // member ID who has ownership to lead the group
  leaderName     String?
  leaderEmail    String?
  status         String                    @default("active")
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationGroupMember[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("organization_group")
}

model OrganizationGroupMember {
  id        String             @id @default(uuid()) @db.Uuid
  groupId   String             @db.Uuid
  memberId  String             @db.Uuid
  role      String             @default("member") // "leader" | "member"
  joinedAt  DateTime           @default(now())

  group     OrganizationGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member    OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
  @@index([groupId])
  @@index([memberId])
  @@map("organization_group_member")
}

model OrganizationDeskAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  deskName       String
  groupName      String?
  assignedToUser String?
  status         String       @default("active")
  assignedAt     DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_desk_assignment")
}

model OrganizationJoinRequest {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String
  userName       String
  userEmail      String
  userAvatar     String?
  department     String?
  message        String?
  status         String       @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId])
  @@map("organization_join_request")
}

model OrganizationAnnouncement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  title          String
  content        String
  priority       String       @default("normal") // "normal" | "urgent" | "event"
  authorName     String
  authorRole     String
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_announcement")
}

model OrganizationAsset {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  type           String       @default("image") // "image" | "template" | "dataset" | "guideline"
  fileUrl        String?      // Image URL or file link
  fileSize       Int?         // Size in bytes
  mimeType       String?      // e.g. "image/png", "image/jpeg"
  description    String?
  downloadsCount Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_asset")
}

model OrganizationMessage {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  senderId       String
  senderName     String
  senderRole     String
  senderAvatar   String?
  content        String
  channel        String       @default("general") // "general" | "announcements" | "staff"
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, channel])
  @@map("organization_message")
}

model OrganizationProject {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  description    String?
  status         String       @default("active")
  createdByEmail String?
  createdByName  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_project")
}

model OrganizationAuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organizerId    String?      @db.Uuid
  action         String
  details        Json?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizer      Organizer?   @relation(fields: [organizerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("organization_audit_log")
}

model UserStar {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   // Target user being starred
  starredById String   // Who gave the star
  createdAt   DateTime @default(now())

  targetUser  User     @relation("UserReceivedStars", fields: [userId], references: [id], onDelete: Cascade)
  starredBy   User     @relation("UserGivenStars", fields: [starredById], references: [id], onDelete: Cascade)

  @@unique([userId, starredById])
  @@index([userId])
  @@index([starredById])
  @@map("user_star")
}
