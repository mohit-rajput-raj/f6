{
  "name": "@repo/workflow-engine",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./functions": {
      "types": "./src/functions.ts",
      "import": "./src/functions.ts",
      "default": "./src/functions.ts"
    }
  },
  "typesVersions": {
    "*": {
      "types": ["./src/types.ts"],
      "functions": ["./src/functions.ts"]
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "^5.5.2"
  }
}
